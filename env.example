# Copy these into your MCP client's environment. slack-mcp never reads a .env file.

# Required. User OAuth Token from the Slack app's "OAuth & Permissions" page.
SLACK_USER_TOKEN=xoxp-your-user-token

# Optional. Directory the file tools may read from and write to. Unset disables them.
# SLACK_FILES_DIR=/path/to/files
# SLACK_MAX_FILE_BYTES=52428800

# Optional. Register only the read tools plus slack_download_file.
# SLACK_READ_ONLY=true

# Optional. Testing and proxies.
# SLACK_API_BASE_URL=https://slack.com/api
# SLACK_DOWNLOAD_HOSTS=

# HTTP mode only.
# MCP_HOST=127.0.0.1
# MCP_PORT=8787
# Each key at least 32 characters, e.g. from: openssl rand -hex 32
# MCP_API_KEYS=replace-with-a-generated-key-of-32-plus-chars
# MCP_ALLOWED_HOSTS=mcp.example.org

# Logging (stderr).
# RUST_LOG=slack_mcp=info
